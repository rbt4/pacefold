{margin-left:14px}.pf24-clock-copy .pf22-seconds{font-size:22px}.pf24-clock-copy .pf22-ampm{font-size:10px;letter-spacing:.18em}.pf24-clock-copy .pf23-seconds-dial{display:none}
.pf24-clock-copy .pf22-date{margin:20px 0 0;color:var(--pf24-soft);font-size:11px;font-weight:750;letter-spacing:.17em;text-transform:uppercase}.pf24-clock-copy .pf22-status{margin:15px 0 0;min-height:auto;padding:8px 13px;border:1px solid var(--pf24-line);border-radius:999px;background:rgba(255,255,255,.52);color:var(--pf24-soft);font-size:10px}.pf24-clock-copy .pf22-progress{width:min(520px,100%);margin:17px 0 0;height:4px;background:rgba(31,72,59,.08)}.pf24-clock-copy .pf22-progress-fill{background:linear-gradient(90deg,var(--pf24-green),#7ca28f)}
.pf24-day-arc{position:relative;z-index:1;margin:0 6px;padding:16px 18px 13px;border:1px solid var(--pf24-line);border-radius:20px;background:rgba(255,255,255,.46)}.pf24-day-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:12px}.pf24-day-head>div{display:grid;gap:2px}.pf24-day-head span{color:var(--pf24-muted);font-size:8px;font-weight:780;letter-spacing:.14em;text-transform:uppercase}.pf24-day-head strong{font-size:12px}.pf24-day-percent{font-size:12px!important;color:var(--pf24-green)!important;font-variant-numeric:tabular-nums}
.pf24-day-rail{position:relative;height:28px}.pf24-day-rail::before{content:"";position:absolute;left:0;right:0;top:13px;height:1px;background:rgba(31,72,59,.17)}.pf24-day-fill{position:absolute;left:0;top:11px;width:calc(var(--pf24-progress,0)*100%);height:5px;border-radius:999px;background:linear-gradient(90deg,var(--pf24-green-deep),#6f9785)}.pf24-day-sun{position:absolute;left:calc(var(--pf24-progress,0)*100%);top:13px;width:17px;height:17px;border:4px solid rgba(255,255,255,.9);border-radius:50%;background:var(--pf24-warm);box-shadow:0 0 0 1px rgba(174,112,35,.4),0 0 22px rgba(213,150,74,.5);transform:translate(-50%,-50%);transition:left .8s ease}.pf24-day-arc[data-state="before"] .pf24-day-sun{background:#aab7b1;box-shadow:0 0 0 1px rgba(80,102,94,.25)}.pf24-day-arc[data-state="complete"] .pf24-day-sun{background:var(--pf24-green)}
.pf24-day-marker{--marker:0;position:absolute;left:calc(var(--marker)*100%);top:9px;width:9px;height:9px;padding:0;border:2px solid rgba(255,255,255,.9);border-radius:50%;background:#789a8c;box-shadow:0 0 0 1px rgba(31,72,59,.2);transform:translateX(-50%);cursor:pointer}.pf24-day-marker[data-source="dhuhr"],.pf24-day-marker[data-source="asr"],.pf24-day-marker[data-source="maghrib"],.pf24-day-marker[data-source="fajr"],.pf24-day-marker[data-source="isha"]{background:#4f8d70}.pf24-day-labels{display:flex;justify-content:space-between;color:var(--pf24-muted);font-size:8px;font-weight:730;letter-spacing:.08em;text-transform:uppercase}.pf24-day-now{opacity:.7}
#pf23-schedule-strip{display:none!important}.pf24-rhythm-strip{position:relative;z-index:1;margin:0 6px;padding:14px 16px;border:1px solid var(--pf24-line);border-radius:20px;background:rgba(255,255,255,.5)}.pf24-rhythm-head{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:10px}.pf24-rhythm-head>div{display:grid;grid-template-columns:auto auto;align-items:baseline;gap:3px 10px}.pf24-rhythm-head span{color:var(--pf24-muted);font-size:8px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.pf24-rhythm-head strong{font-size:11px}.pf24-rhythm-head small{grid-column:1/-1;color:var(--pf24-muted);font-size:8px}.pf24-rhythm-adjust{border:0;background:transparent;color:var(--pf24-green);font-size:8px;font-weight:820;letter-spacing:.13em;text-transform:uppercase;cursor:pointer}.pf24-rhythm-items{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px}.pf24-rhythm-item{display:grid;gap:4px;min-height:48px;padding:9px 11px;border:1px solid transparent;border-radius:13px;background:rgba(255,255,255,.55);color:var(--pf24-soft);text-align:left;cursor:pointer}.pf24-rhythm-item span{font-size:8px;font-weight:780;letter-spacing:.08em;text-transform:uppercase}.pf24-rhythm-item strong{font-size:12px;font-variant-numeric:tabular-nums}.pf24-rhythm-item[data-state="past"]{opacity:.46}.pf24-rhythm-item[data-state="next"]{color:#fff;background:linear-gradient(145deg,var(--pf24-green),var(--pf24-green-deep));box-shadow:0 10px 24px rgba(24,63,53,.19)}
.pf22-spatial-root[data-experience="unified-r1"] .pf23-action-dock{position:relative;z-index:1;width:auto!important;margin:0 6px!important;padding:11px!important;border:1px solid var(--pf24-line)!important;border-radius:20px!important;background:rgba(255,255,255,.58)!important;box-shadow:none!important}.pf22-spatial-root[data-experience="unified-r1"] .pf23-action-grid{gap:7px!important}.pf22-spatial-root[data-experience="unified-r1"] .pf23-action{min-height:54px!important;border:1px solid rgba(31,72,59,.08)!important;border-radius:13px!important;background:rgba(255,255,255,.63)!important}.pf22-spatial-root[data-experience="unified-r1"] .pf23-action:hover{transform:translateY(-1px);background:#fff!important;box-shadow:0 9px 22px rgba(24,52,45,.08)}.pf22-spatial-root[data-experience="unified-r1"] .pf23-log-receipt{margin-top:8px;padding-top:8px}
.pf24-fold-tray{positi