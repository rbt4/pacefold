  for(const token of ['.pf24-instrument','.pf24-day-arc','.pf24-fold-tray','.pf24-settings-overview','@media(forced-colors:active)'])if(!css.includes(token))throw new Error(`V24 CSS token missing: ${token}`);
  for(const token of [`const RELEASE='${RELEASE}'`,'window.__PACEFOLD_UNIFIED__','computePrayerHours','zoneOffsetHours','buildFoldTray'])if(!runtime.includes(token))throw new Error(`V24 runtime token missing: ${token}`);
  for(const token of ['window.__PACEFOLD_RHYTHM__','__PACEFOLD_MA_SCHEDULER__','pacefold.backup.v2'])if(!kernel.includes(token))throw new Error(`V24 kernel token missing: ${token}`)
}
