;border-radius:999px;background:#c9d1cd;transform:translateY(-50%)}.pf24-setting i::after{content:"";position:absolute;left:2px;top:2px;width:11px;height:11px;border-radius:50%;background:#fff;transition:transform .18s ease}.pf24-setting[data-active="true"] i{background:var(--pf24-green)}.pf24-setting[data-active="true"] i::after{transform:translateX(12px)}
html[data-theme="night"] .pf22-spatial-root[data-experience="unified-r1"],body[data-theme="night"] .pf22-spatial-root[data-experience="unified-r1"]{--pf24-ink:#e8f0eb;--pf24-soft:#c1d0c8;--pf24-muted:#91a69b;--pf24-line:rgba(221,239,229,.13);--pf24-paper:rgba(23,38,33,.78);--pf24-paper-strong:rgba(28,44,38,.94);background:radial-gradient(circle at 78% 8%,rgba(194,139,71,.14),transparent 30%),linear-gradient(145deg,#14221e,#1c2c26 58%,#17251f)!important}.pf22-spatial-root[data-experience="unified-r1"][data-day-phase="night"]{background:radial-gradient(circle at 76% 9%,rgba(122,160,190,.15),transparent 30%),linear-gradient(145deg,#14221e,#1b2924 58%,#17251f)!important}
@media(max-height:900px) and (min-width:821px){.pf22-spatial-root[data-experience="unified-r1"] .pf22-face-home{padding-top:66px}.pf22-spatial-root[data-experience="unified-r1"] .pf22-clock-hero{gap:10px;padding:20px 28px}.pf24-instrument{min-height:230px}.pf24-dial{width:clamp(180px,19vw,235px)}.pf24-clock-copy .pf22-time-main{font-size:clamp(72px,8vw,108px)}.pf24-day-arc{padding-top:12px;padding-bottom:10px}.pf24-rhythm-item{min-height:42px}.pf22-spatial-root[data-experience="unified-r1"] .pf23-action{min-height:48px!important}.pf24-fold-body{min-height:105px}.pf24-fold-note{padding:5px 0}}
@media(max-width:980px){.pf24-instrument{grid-template-columns:minmax(210px,.68fr) minmax(360px,1.32fr);gap:24px}.pf24-fold-body{grid-template-columns:1fr}.pf24-fold-summary{border-right:0;border-bottom:1px solid rgba(31,72,59,.09)}.pf24-rhythm-items{overflow-x:auto;grid-template-columns:repeat(5,minmax(105px,1fr))}}
@media(max-width:760px){.pf22-spatial-root[data-experience="unified-r1"] .pf22-topbar{height:50px;padding:0 16px}.pf22-spatial-root[data-experience="unified-r1"] .pf22-face-home{padding:58px 10px 28px!important}.pf22-spatial-root[data-experience="unified-r1"] .pf22-clock-hero{width:100%;padding:17px 12px;border-radius:26px;gap:10px}.pf24-instrument{grid-template-columns:1fr;gap:12px;min-height:auto;padding:4px}.pf24-dial{width:min(54vw,230px)}.pf24-dial-caption{display:none}.pf24-clock-copy{align-items:center;text-align:center}.pf24-clock-copy .pf22-home-mark{display:none}.pf24-clock-copy .pf22-time{justify-content:center}.pf24-clock-copy .pf22-time-main{font-size:clamp(64px,20vw,94px)}.pf24-clock-copy .pf22-date{margin-top:13px}.pf24-clock-copy .pf22-progress{width:82vw}.pf24-day-arc,.pf24-rhythm-strip,.pf22-spatial-root[data-experience="unified-r1"] .pf23-action-dock,.pf24-fold-tray{margin-left:0!important;margin-right:0!important}.pf24-rhythm-head{align-items:flex-start}.pf24-rhythm-head>div{grid-template-columns:1fr}.pf24-rhythm-head small{max-width:70vw}.pf24-rhythm-items{grid-template-columns:repeat(5,102px);padding-bottom:3px}.pf22-spatial-root[data-experience="unified-r1"] .pf23-action-grid{grid-template-columns:repeat(2,1fr)!important}.pf24-fold-head{align-items:flex-start;gap:10px}.pf24-fold-tabs{overflow-x:auto;max-width:70%}.pf24-fold-summary{grid-template-columns:repeat(2,1fr)}.pf24-fold-body{min-height:auto}.pf24-fold-latest{min-height:118px}.pf22-spatial-root[data-experience="unified-r1"] .pf22-face:not(.pf22-face-home){padding:58px 12px 26px}.pf24-settings-grid{grid-template-columns:1fr}.pf22-spatial-root[data-experience="unified-r1"] .pf22-face-heading h1{font-size:23px}}
@media(max-width:420px) and (max-height:740px){.pf24-dial{width:150px}.pf24-clock-copy .pf22-time-main{font-size:58px}.pf24-day-head,.pf24-rhythm-head small,.pf24-fold-latest,.pf23-log-receipt{display:none!important}.pf24-day-arc{padding:9px 12px}.pf24-rhythm-strip{padding:10px}.pf24-fold-summary{padding:9px}.pf24-fold-card{min-height:52px}.pf22-spatial-root[data-experience="unified-r1"] .pf23-action{min-height:44px!important}}
@media(prefers-reduced-motion:reduce){.pf24-day-sun,.pf24-setting i::after,.pf22-spatial-root[data-experience="unified-r1"] *{transition:none!important;animation:none!important}}
@media(forced-colors:active){.pf24-dial,.pf24-day-arc,.pf24-rhythm-strip,.pf24-fold-tray,.pf24-setting{border:1px solid CanvasText;background:Canvas}.pf24-day-fill,.pf24-day-sun,.pf24-rhythm-item[data-state="next"],.pf24-setting[data-active="true"] i{background:Highlight;color:HighlightText}.pf24-hand,.pf24-tick{background:CanvasText}}
