/* Pacefold 24 — one current day instrument. */
:root{--pf24-ink:#18342d;--pf24-soft:#48665d;--pf24-muted:#73877f;--pf24-line:rgba(30,69,57,.13);--pf24-paper:rgba(255,255,252,.78);--pf24-paper-strong:rgba(255,255,253,.94);--pf24-green:#245f4d;--pf24-green-deep:#173f35;--pf24-warm:#d5964a;--pf24-blue:#6c98bd;--pf24-violet:#8d82b5;--pf24-sage:#7fa08e;--pf24-shadow:0 28px 90px rgba(24,52,45,.12)}
.pf22-spatial-root[data-experience="unified-r1"]{color:var(--pf24-ink);background:radial-gradient(circle at 77% 8%,rgba(255,210,128,.2),transparent 28%),radial-gradient(circle at 20% 84%,rgba(111,157,139,.12),transparent 32%),linear-gradient(145deg,#f2f3ed,#e6ece6 58%,#edf0e9)!important}
.pf22-spatial-root[data-experience="unified-r1"]::before{inset:10px;border:1px solid rgba(35,76,63,.15);border-radius:30px;box-shadow:inset 0 1px 0 rgba(255,255,255,.78)}
.pf22-spatial-root[data-experience="unified-r1"]::after{display:none!important}
.pf22-spatial-root[data-experience="unified-r1"] .pf22-topbar{height:58px;padding:0 clamp(24px,4vw,58px);background:linear-gradient(180deg,rgba(248,249,245,.82),rgba(248,249,245,.45));backdrop-filter:blur(18px);border-bottom:1px solid rgba(35,76,63,.08)}
.pf22-spatial-root[data-experience="unified-r1"] .pf22-brand{font-size:11px;letter-spacing:.28em}.pf22-spatial-root[data-experience="unified-r1"] .pf22-current-mode{border:1px solid var(--pf24-line);border-radius:999px;padding:7px 16px;background:rgba(255,255,255,.58);font-size:9px;letter-spacing:.16em}.pf22-spatial-root[data-experience="unified-r1"] .pf22-quiet{min-width:76px;height:34px;border:1px solid var(--pf24-line);border-radius:999px;background:rgba(255,255,255,.68);font-weight:720}.pf22-spatial-root[data-experience="unified-r1"] .pf22-quiet[data-active="true"]{color:#fff;background:var(--pf24-green-deep);border-color:transparent}
.pf22-spatial-root[data-experience="unified-r1"] .pf22-face-home{padding:74px clamp(18px,3vw,46px) 28px!important;overflow:auto!important}
.pf22-spatial-root[data-experience="unified-r1"] .pf22-clock-hero{width:min(1180px,94vw);min-height:auto;height:auto;padding:clamp(22px,3vw,36px);border:1px solid rgba(31,72,59,.14);border-radius:38px;background:linear-gradient(145deg,rgba(255,255,253,.9),rgba(248,250,246,.62));box-shadow:var(--pf24-shadow),inset 0 1px 0 #fff;backdrop-filter:blur(24px);overflow:visible;display:flex;flex-direction:column;gap:14px}
.pf22-spatial-root[data-experience="unified-r1"] .pf22-clock-hero::before{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:linear-gradient(115deg,rgba(255,255,255,.7),transparent 28%),radial-gradient(circle at 78% 12%,rgba(234,177,87,.12),transparent 31%)}
.pf24-instrument{position:relative;z-index:1;display:grid;grid-template-columns:minmax(250px,.72fr) minmax(420px,1.28fr);align-items:center;gap:clamp(24px,4vw,58px);min-height:286px;padding:8px clamp(8px,2vw,24px) 4px}
.pf24-dial-wrap{display:grid;justify-items:center;gap:12px}.pf24-dial{--pf24-hour:0deg;--pf24-minute:0deg;--pf24-second:0deg;position:relative;width:clamp(210px,23vw,300px);aspect-ratio:1;border:1px solid rgba(31,72,59,.2);border-radius:50%;background:radial-gradient(circle at 44% 34%,#fff,rgba(255,255,255,.76) 45%,rgba(229,237,231,.72));box-shadow:0 25px 65px rgba(26,59,49,.12),inset 0 0 0 9px rgba(255,255,255,.38),inset 0 0 0 10px rgba(35,76,63,.07)}
.pf24-tick{--tick:0;position:absolute;left:50%;top:7px;width:1px;height:5px;background:rgba(24,52,45,.3);transform-origin:50% calc((clamp(210px,23vw,300px) / 2) - 7px);transform:translateX(-50%) rotate(calc(var(--tick)*6deg))}.pf24-tick-major{height:11px;width:2px;background:rgba(24,52,45,.58)}
.pf24-hand{position:absolute;left:50%;bottom:50%;width:3px;border-radius:999px;background:var(--pf24-ink);transform-origin:50% 100%;box-shadow:0 2px 5px rgba(24,52,45,.18)}.pf24-hour{height:25%;transform:translateX(-50%) rotate(var(--pf24-hour))}.pf24-minute{height:35%;width:2px;transform:translateX(-50%) rotate(var(--pf24-minute))}.pf24-second{height:39%;width:1px;background:var(--pf24-warm);transform:translateX(-50%) rotate(var(--pf24-second))}.pf24-dial[data-seconds="false"] .pf24-second{display:none}.pf24-hub{position:absolute;left:50%;top:50%;width:13px;height:13px;border:4px solid var(--pf24-paper-strong);border-radius:50%;background:var(--pf24-green);transform:translate(-50%,-50%);box-shadow:0 2px 8px rgba(24,52,45,.22)}
.pf24-dial-caption{display:flex;align-items:center;gap:9px;color:var(--pf24-muted);font-size:9px;letter-spacing:.1em;text-transform:uppercase}.pf24-dial-caption strong{color:var(--pf24-ink);font-size:10px}
.pf24-clock-copy{position:relative;display:flex;flex-direction:column;align-items:flex-start;text-align:left}.pf24-clock-copy .pf22-home-mark{margin:0 0 12px}.pf24-clock-copy .pf22-home-mark span{font-size:11px;letter-spacing:.34em}.pf24-clock-copy .pf22-home-mark small{margin-top:5px;font-size:9px;letter-spacing:.16em;color:var(--pf24-muted)}
.pf24-clock-copy .pf22-time{justify-content:flex-start}.pf24-clock-copy .pf22-time-main{font-size:clamp(78px,9vw,132px);line-height:.86;font-weight:245;letter-spacing:-.06em;color:var(--pf24-ink);text-shadow:none}.pf24-clock-copy .pf22-time-side