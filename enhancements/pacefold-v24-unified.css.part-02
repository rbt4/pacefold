on:relative;z-index:1;margin:0 6px;border:1px solid rgba(31,72,59,.15);border-radius:22px 22px 30px 30px;background:linear-gradient(180deg,rgba(252,251,245,.95),rgba(244,241,231,.92));box-shadow:0 17px 36px rgba(28,54,46,.08),inset 0 1px 0 #fff;overflow:hidden}.pf24-fold-tray::before{content:"";position:absolute;left:50%;top:0;width:72px;height:6px;border-radius:0 0 999px 999px;background:rgba(31,72,59,.09);transform:translateX(-50%)}.pf24-fold-head{display:flex;align-items:center;justify-content:space-between;padding:13px 16px 10px;border-bottom:1px solid rgba(31,72,59,.09)}.pf24-fold-head>div{display:grid;gap:1px}.pf24-fold-head span{color:var(--pf24-muted);font-size:8px;font-weight:820;letter-spacing:.16em;text-transform:uppercase}.pf24-fold-head strong{font-size:11px}.pf24-fold-tabs{display:flex;gap:5px}.pf24-fold-tab{height:29px;padding:0 11px;border:1px solid rgba(31,72,59,.1);border-radius:999px;background:rgba(255,255,255,.55);color:var(--pf24-soft);font-size:8px;font-weight:780;cursor:pointer}.pf24-fold-tab:hover{color:#fff;background:var(--pf24-green);border-color:transparent}.pf24-fold-body{display:grid;grid-template-columns:.9fr 1.1fr;min-height:126px}.pf24-fold-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;padding:13px;border-right:1px solid rgba(31,72,59,.09)}.pf24-fold-card{display:grid;align-content:center;gap:2px;padding:9px;border:1px solid rgba(31,72,59,.08);border-radius:13px;background:rgba(255,255,255,.48);text-align:left;cursor:pointer}.pf24-fold-card span,.pf24-fold-card small{color:var(--pf24-muted);font-size:7px;font-weight:760;letter-spacing:.08em;text-transform:uppercase}.pf24-fold-card strong{font-size:17px;font-weight:620}.pf24-fold-latest{padding:12px 14px}.pf24-fold-latest>header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}.pf24-fold-latest>header span{color:var(--pf24-muted);font-size:8px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.pf24-fold-add{border:0;background:transparent;color:var(--pf24-green);font-size:8px;font-weight:800;cursor:pointer;text-transform:uppercase}.pf24-fold-note-list{display:grid}.pf24-fold-note{display:grid;grid-template-columns:54px 1fr;gap:8px;padding:7px 0;border:0;border-bottom:1px solid rgba(31,72,59,.07);background:transparent;text-align:left;cursor:pointer}.pf24-fold-note span{color:var(--pf24-muted);font-size:8px}.pf24-fold-note strong{overflow:hidden;color:var(--pf24-soft);font-size:9px;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.pf24-fold-note-list p{margin:20px 0;color:var(--pf24-muted);font-size:10px}
.pf22-spatial-root[data-experience="unified-r1"] .pf22-edge{opacity:.32}.pf22-spatial-root[data-experience="unified-r1"] .pf22-edge:hover,.pf22-spatial-root[data-experience="unified-r1"] .pf22-edge:focus-visible{opacity:1;background:rgba(255,255,255,.75)}.pf22-spatial-root[data-experience="unified-r1"] .pf22-mode-dots{bottom:16px}
.pf22-spatial-root[data-experience="unified-r1"] .pf22-face:not(.pf22-face-home){padding:76px clamp(24px,5vw,72px) 38px;background:linear-gradient(145deg,rgba(255,255,255,.22),transparent 52%)}.pf22-spatial-root[data-experience="unified-r1"] .pf22-face-head{height:60px;padding:0 3px 14px}.pf22-spatial-root[data-experience="unified-r1"] .pf22-face-heading h1{font-size:30px;font-weight:600;letter-spacing:-.03em}.pf22-spatial-root[data-experience="unified-r1"] .pf22-home-button{height:34px;padding:0 14px;border:1px solid var(--pf24-line);border-radius:999px;background:rgba(255,255,255,.65)}
.pf22-spatial-root[data-experience="unified-r1"] .pf22-capture,.pf22-spatial-root[data-experience="unified-r1"] .pf22-notes-recent,.pf22-spatial-root[data-experience="unified-r1"] .pf22-log-stream,.pf22-spatial-root[data-experience="unified-r1"] .pf22-log-summary,.pf22-spatial-root[data-experience="unified-r1"] .pf22-context-weather,.pf22-spatial-root[data-experience="unified-r1"] .pf22-context-now,.pf22-spatial-root[data-experience="unified-r1"] .pf23-context-schedule,.pf22-spatial-root[data-experience="unified-r1"] .pf22-settings-card,.pf22-spatial-root[data-experience="unified-r1"] .pf22-sound-card{border:1px solid var(--pf24-line);border-radius:24px;background:var(--pf24-paper);box-shadow:0 16px 48px rgba(24,52,45,.06),inset 0 1px 0 rgba(255,255,255,.85)}
.pf24-settings-overview{margin:-4px -4px 18px;padding:16px;border:1px solid rgba(31,72,59,.09);border-radius:18px;background:rgba(255,255,255,.44)}.pf24-settings-overview>header{display:grid;gap:2px;margin-bottom:12px}.pf24-settings-overview>header span{color:var(--pf24-muted);font-size:8px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.pf24-settings-overview>header strong{font-size:13px}.pf24-settings-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.pf24-setting{position:relative;display:grid;gap:2px;min-height:58px;padding:11px 42px 11px 12px;border:1px solid rgba(31,72,59,.09);border-radius:14px;background:rgba(255,255,255,.58);text-align:left;cursor:pointer}.pf24-setting span{font-size:10px;font-weight:730}.pf24-setting small{color:var(--pf24-muted);font-size:8px;line-height:1.3}.pf24-setting i{position:absolute;right:12px;top:50%;width:27px;height:15px