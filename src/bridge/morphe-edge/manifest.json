{
  "manifest_version": 3,
  "name": "Pacefold Music Bridge",
  "version": "0.9.0",
  "description": "A private local bridge between Pacefold and YouTube Music for richer playback control, ad interruption handling, and SponsorBlock skips.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://sponsor.ajay.app/*",
    "https://rbt4.github.io/pacefold/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://rbt4.github.io/pacefold/*"],
      "js": ["pacefold-relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["youtube-music-engine.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Pacefold Music Bridge"
  }
}
